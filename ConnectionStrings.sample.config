<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to ConnectionStrings.config and change the server name if needed -->
<connectionStrings>
  <add name="AttendanceDb"
       connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StudentAttendanceDB;Integrated Security=True"
       providerName="System.Data.SqlClient" />
</connectionStrings>
